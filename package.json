{
	"name": "esponja",
	"description": "Open events platform",
	"version": "1.0",
	"author": "Balthazaurus",
	"scripts": {
		"start": "node build",
		"dev": "vite dev",
		"build": "vite build",
		"package": "svelte-kit package",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . --ignore-path ./.eslintignore",
		"format": "prettier --write . --ignore-path ./.eslintignore",
		"db_create": "psql -d postgres -f db_create.sql"
	},
	"engines": {
		"node": "^18.19.1"
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.596.0",
		"@sveltejs/adapter-vercel": "^5.3.2",
		"date-fns": "^3.6.0",
		"nodemailer": "^6.9.14",
		"pg": "^8.11.5",
		"sanitize-html": "^2.13.0",
		"sharp": "^0.32.6"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.0.1",
		"@sveltejs/kit": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^3.1.0",
		"@types/dompurify": "^3",
		"@types/jsonwebtoken": "^9.0.6",
		"@types/multer": "^1",
		"@types/nodemailer": "^6",
		"@types/pg": "^8.11.5",
		"@types/sanitize-html": "^2",
		"@typescript-eslint/eslint-plugin": "^7.7.1",
		"@typescript-eslint/parser": "^7.7.1",
		"eslint": "^9.1.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.38.0",
		"jsonwebtoken": "^9.0.2",
		"prettier": "^3.2.5",
		"prettier-plugin-svelte": "^3.2.3",
		"sass": "^1.75.0",
		"svelte": "^4.2.15",
		"svelte-check": "^3.7.0",
		"tslib": "^2.6.2",
		"typescript": "^5.4.5",
		"vite": "^5.2.10",
		"vitest": "^1.5.2"
	},
	"packageManager": "yarn@4.1.1",
	"prettier": "./prettier.config.mjs"
}
