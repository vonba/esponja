{
	"name": "esponja",
	"description": "Open events platform",
	"version": "1.0",
	"author": "Balthazaurus",
	"scripts": {
		"start": "node build",
		"dev": "vite dev",
		"build": "vite build",
		"package": "svelte-kit package",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . --ignore-path ./.eslintignore",
		"format": "prettier --write . --ignore-path ./.eslintignore",
		"db_create": "bash db_create.sh"
	},
	"engines": {
		"node": "^22"
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1165.0",
		"@googlemaps/js-api-loader": "^1.16.6",
		"@neondatabase/serverless": "^1.1.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@vercel/analytics": "^1.3.1",
		"@vercel/functions": "^3.11.1",
		"jimp": "^0.22.12",
		"lottie-web": "^5.12.2",
		"nodemailer": "^10.3.1",
		"pg": "^8.11.5",
		"string-strip-html": "^13.7.8"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"@types/jsonwebtoken": "^9.0.6",
		"@types/pg": "^8.11.5",
		"@typescript-eslint/eslint-plugin": "^7.7.1",
		"@typescript-eslint/parser": "^7.7.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.38.0",
		"jsonwebtoken": "^9.0.3",
		"prettier": "^3.2.5",
		"prettier-plugin-svelte": "^3.2.3",
		"sass": "^1.75.0",
		"svelte": "^4.2.15",
		"svelte-check": "^3.7.0",
		"typescript": "^5.4.5",
		"vite": "^5.4.21"
	},
	"packageManager": "yarn@4.1.1",
	"prettier": "./prettier.config.mjs",
	"resolutions": {
		"tar": "^7.5.22",
		"rollup": "4.64.5"
	}
}
